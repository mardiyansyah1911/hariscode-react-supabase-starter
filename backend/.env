# Database Configuration
DATABASE_URL=postgresql://hariscode:hariscode123@localhost:5432/hariscode
DB_HOST=localhost
DB_PORT=5432
DB_USER=hariscode
DB_PASSWORD=hariscode123
DB_NAME=hariscode

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-this-is-not-secure
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1

# Code Execution Settings
CODE_EXECUTION_TIMEOUT=30000
MAX_MEMORY_USAGE=128000000
MAX_CPU_TIME=5000

# Email Configuration (Optional - for development, we'll mock emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@hariscode.com
FROM_NAME=Haris Code

# External Services
JUDGE0_API_KEY=
JUDGE0_BASE_URL=https://api.judge0.com

# Security Settings
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:5173

# Frontend URL
FRONTEND_URL=http://localhost:5173

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Redis (Optional - for caching and sessions)
REDIS_URL=redis://:redis123@localhost:6379
REDIS_PASSWORD=redis123

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=

# Development Settings
DEBUG=true
MOCK_EMAIL=true